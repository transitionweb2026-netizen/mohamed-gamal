# ─── Website + dashboard (Vercel → Project → Settings → Environment Variables, and .env.local) ───

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…) — or the legacy "anon" key.
# Safe in the browser: Row Level Security decides what it can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The production address, e.g. https://www.drmohamedgamal.com (also editable in the dashboard under SEO).
NEXT_PUBLIC_SITE_URL=

# ─── Development only ───
# Use a local test database (in .cms-local/) for the dashboard while Supabase is not connected.
# CMS_LOCAL=1

# ─── Setup script only (your computer — NEVER add to Vercel or commit) ───
# Supabase → Connect → Session pooler connection string, with the database password.
# SUPABASE_DB_URL=

# The service role / secret key is NOT used anywhere in this project. Do not add it.
